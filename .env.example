# Copie para .env.local e preencha apenas no seu computador.
# Este exemplo deve permanecer sem credenciais reais.
# npm start e npm run build leem .env.local (Node.js 22).
# Na Vercel, cadastre os mesmos nomes em Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional e exclusiva do backend:
SUPABASE_SECRET_KEY=
